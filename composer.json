{
    "name": "faridm/ai-chat-state-machine",
    "description": "A deterministic, framework-agnostic state machine for step-by-step chat flows (lead forms, support bots, onboarding wizards) in PHP: validated server-side, optional AI fallback, with a drop-in multilingual (RTL-ready) browser widget and Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "chat",
        "chatbot",
        "state-machine",
        "conversation",
        "flow",
        "wizard",
        "lead-form",
        "widget",
        "rtl",
        "i18n",
        "ai",
        "llm",
        "laravel",
        "php"
    ],
    "homepage": "https://github.com/faridmasoum/stepchat",
    "readme": "README.md",
    "authors": [
        {
            "name": "Farid Masoum",
            "email": "faridmasoum@outlook.com"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0"
    },
    "suggest": {
        "illuminate/support": "Enables the Laravel integration (service provider, widget route, Blade directive, cache session store) on Laravel 8 through 12."
    },
    "autoload": {
        "psr-4": {
            "FaridM\\AiChatStateMachine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FaridM\\AiChatStateMachine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FaridM\\AiChatStateMachine\\Laravel\\AiChatStateMachineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "support": {
        "issues": "https://github.com/faridmasoum/stepchat/issues",
        "source": "https://github.com/faridmasoum/stepchat"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    }
}
