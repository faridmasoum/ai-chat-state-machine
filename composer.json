{
    "name": "farid/ai-chat-state-machine",
    "description": "A deterministic, framework-agnostic state machine for building step-by-step AI chat flows (lead forms, support bots, onboarding wizards) in PHP, with optional Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ai", "chat", "chatbot", "state-machine", "conversation", "flow", "wizard", "laravel"],
    "authors": [
        {
            "name": "Farid",
            "email": "gray.skyy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0"
    },
    "suggest": {
        "illuminate/support": "Allows registering the AiChatStateMachineServiceProvider for auto-persistence helpers in Laravel 8 through 12."
    },
    "autoload": {
        "psr-4": {
            "Farid\\AiChatStateMachine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Farid\\AiChatStateMachine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Farid\\AiChatStateMachine\\Laravel\\AiChatStateMachineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
